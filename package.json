{
  "name": "micro-pad",
  "version": "1.0.5",
  "type": "module",
  "bin": {
    "micro-pad": "dist/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsx build.ts",
    "start": "node dist/server.js",
    "format": "pnpm biome format",
    "lint": "pnpm biome lint",
    "lint:check": "pnpm biome check",
    "release": "pnpm release-it",
    "release:test": "pnpm release-it --dry-run"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@hono/node-server": "^2.0.4",
    "@release-it/conventional-changelog": "11.0.1",
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.0",
    "esbuild-node-externals": "1.22.0",
    "hono": "4.12.25",
    "release-it": "20.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "micro-pad",
    "pad",
    "collaborative",
    "editor"
  ],
  "author": "Clément BERARD <contact@berard.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clement-berard/micro-pad.git"
  },
  "bugs": {
    "url": "https://github.com/clement-berard/micro-pad/issues"
  },
  "homepage": "https://github.com/clement-berard/micro-pad",
  "files": [
    "dist",
    "docs"
  ]
